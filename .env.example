[TEMPLATE]
# --- Frontend (Vite) ---

# Shopify store keys (optional — enables live catalog + real checkout)
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# --- Supabase (replaces the MongoDB API server) ---
# Get these from your Supabase project: Dashboard → Project Settings → API
#   URL:        Project URL (https://xxxx.supabase.co)
#   anon key:   "anon public" key
# Run supabase/schema.sql in the SQL Editor first to create the tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy MongoDB API server (optional — only used if Supabase is NOT configured)
# VITE_API_URL=http://localhost:3001

# --- Backend (server/index.js, optional now) ---

# MongoDB Atlas connection string (only needed if you keep the Express server)
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?retryWrites=true
MONGODB_DB=need-store
